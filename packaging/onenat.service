# oneNat systemd 服务模板
# 安装:
#   sudo cp bin/ngrokd-linux-<arch> /usr/local/bin/ngrokd
#   sudo cp onenat.service /etc/systemd/system/   (按需修改下面两行)
#   sudo systemctl daemon-reload && sudo systemctl enable --now onenat
[Unit]
Description=oneNat tunnel server (with web dashboard)
After=network-online.target
Wants=network-online.target

[Service]
# TODO: 改成你的实际目录 (解压目录) 与对外域名
WorkingDirectory=/opt/onenat
ExecStart=/usr/local/bin/ngrokd -domain your.domain.com -tunnelAddr :4443 -httpAddr :80 -httpsAddr "" -webAddr :18080 -webData /opt/onenat/onenat-dashboard.json -dlDir /opt/onenat/dl
Restart=always
RestartSec=3
# 对外端口 >=1024 无需特权; 若用 80/443 可加:
# AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
